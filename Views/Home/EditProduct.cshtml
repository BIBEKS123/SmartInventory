@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model SmartInventory.Models.Product

@{
    Layout = null;

    var price = Model.Price.ToString(
        System.Globalization.CultureInfo.InvariantCulture);

    var purchaseDate = Model.PurchaseDate?.ToString("yyyy-MM-dd") ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Product - SmartInventory</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 35px 15px;
            font-family: Arial, sans-serif;
            background: #f5f0e8;
            color: #38291f;
        }

        .container {
            max-width: 750px;
            margin: auto;
            padding: 35px;
            background: #fffdf9;
            border-radius: 16px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

        h1 {
            margin-top: 0;
            color: #493326;
        }

        .subtitle {
            color: #8a786b;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        input, textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #d8c9ba;
            border-radius: 8px;
            font-size: 15px;
            background: white;
        }

        textarea {
            min-height: 100px;
            resize: vertical;
        }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #493326;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

            button:hover {
                background: #684b38;
            }

        .back-link {
            display: inline-block;
            margin-top: 18px;
            color: #684b38;
            text-decoration: none;
        }

        .validation {
            color: #c0392b;
            margin-bottom: 15px;
        }
    </style>
</head>

<body>
    <div class="container">

        <h1>Edit Product</h1>
        <p class="subtitle">Update all product details below.</p>

        <div class="validation">
            @Html.ValidationSummary()
        </div>

        <form action="@Url.Action("EditProduct", "Home")"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group">
                <label for="Name">Product Name *</label>
                <input type="text" id="Name" name="Name"
                       value="@Model.Name" required />
            </div>

            <div class="form-group">
                <label for="Category">Category</label>
                <input type="text" id="Category" name="Category"
                       value="@Model.Category" />
            </div>

            <div class="form-group">
                <label for="Description">Description</label>
                <textarea id="Description" name="Description">@Model.Description</textarea>
            </div>

            <div class="form-group">
                <label for="Price">Price *</label>
                <input type="number" id="Price" name="Price"
                       value="@price" step="0.01" min="0.01" required />
            </div>

            <div class="form-group">
                <label for="Stock">Stock *</label>
                <input type="number" id="Stock" name="Stock"
                       value="@Model.Stock" min="0" required />
            </div>

            <div class="form-group">
                <label for="SKU">SKU / Barcode</label>
                <input type="text" id="SKU" name="SKU"
                       value="@Model.SKU" />
            </div>

            <div class="form-group">
                <label for="SupplierName">Supplier Name</label>
                <input type="text" id="SupplierName" name="SupplierName"
                       value="@Model.SupplierName" />
            </div>

            <div class="form-group">
                <label for="PurchaseDate">Purchase Date</label>
                <input type="date" id="PurchaseDate" name="PurchaseDate"
                       value="@purchaseDate" />
            </div>

            <button type="submit">Update Product</button>
        </form>

        <a href="@Url.Action("Products", "Home")" class="back-link">
            ← Back to Products
        </a>

    </div>
</body>
</html>
