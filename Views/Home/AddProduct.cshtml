@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model SmartInventory.Models.Product

@{
    Layout = null;
    var purchaseDate = Model?.PurchaseDate?.ToString("yyyy-MM-dd") ?? "";
    var price = Model == null ? "" : Model.Price.ToString(
        System.Globalization.CultureInfo.InvariantCulture);
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Add Product - SmartInventory</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 35px 15px;
            font-family: Arial, sans-serif;
            background: #f5f0e8;
            color: #38291f;
        }

        .container {
            max-width: 750px;
            margin: auto;
            padding: 35px;
            background: #fffdf9;
            border-radius: 16px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

        h1 {
            margin-top: 0;
            color: #493326;
        }

        .subtitle {
            color: #8a786b;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        input, textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #d8c9ba;
            border-radius: 8px;
            font-size: 15px;
            background: white;
        }

        textarea {
            min-height: 100px;
            resize: vertical;
        }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #493326;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

            button:hover {
                background: #684b38;
            }

        .back-link {
            display: inline-block;
            margin-top: 18px;
            color: #684b38;
            text-decoration: none;
        }

        .validation {
            color: #c0392b;
            margin-bottom: 15px;
        }
    </style>
</head>

<body>
    <div class="container">

        <h1>Add New Product</h1>
        <p class="subtitle">Enter the product details below.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form action="@Url.Action("AddProduct", "Home")"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Name">Product Name *</label>
                <input type="text" id="Name" name="Name"
                       value="@Model?.Name"
                       placeholder="Enter product name" required />
            </div>

            <div class="form-group">
                <label for="Category">Category</label>
                <input type="text" id="Category" name="Category"
                       value="@Model?.Category"
                       placeholder="Enter category" />
            </div>

            <div class="form-group">
                <label for="Description">Description</label>
                <textarea id="Description" name="Description"
                          placeholder="Enter product description">@Model?.Description</textarea>
            </div>

            <div class="form-group">
                <label for="Price">Price *</label>
                <input type="number" id="Price" name="Price"
                       value="@price" step="0.01" min="0.01"
                       placeholder="Enter price" required />
            </div>

            <div class="form-group">
                <label for="Stock">Stock *</label>
                <input type="number" id="Stock" name="Stock"
                       value="@Model?.Stock"
                       min="0" placeholder="Enter stock quantity" required />
            </div>

            <div class="form-group">
                <label for="SKU">SKU / Barcode</label>
                <input type="text" id="SKU" name="SKU"
                       value="@Model?.SKU"
                       placeholder="Enter SKU or barcode" />
            </div>

            <div class="form-group">
                <label for="SupplierName">Supplier Name</label>
                <input type="text" id="SupplierName" name="SupplierName"
                       value="@Model?.SupplierName"
                       placeholder="Enter supplier name" />
            </div>

            <div class="form-group">
                <label for="PurchaseDate">Purchase Date</label>
                <input type="date" id="PurchaseDate" name="PurchaseDate"
                       value="@purchaseDate" />
            </div>

            <div class="form-group">
                <label for="ImageFile">Product Photo</label>
                <input type="file" id="ImageFile" name="ImageFile"
                       accept=".jpg,.jpeg,.png,.webp" />
            </div>

            <button type="submit">Save Product</button>
        </form>

        <a href="@Url.Action("Products", "Home")" class="back-link">
            ← Back to Products
        </a>

    </div>
</body>
</html>
