@model SmartInventory.Models.Sale

@{
    Layout = null;

    var shopName = "SmartInventory Store";

    var customerName = string.IsNullOrWhiteSpace(Model.CustomerName)
        ? "Walk-in Customer"
        : Model.CustomerName;

    var customerPhone = string.IsNullOrWhiteSpace(Model.CustomerPhone)
        ? "Not provided"
        : Model.CustomerPhone;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Invoice - INV-@Model.Id</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            background: #f5efe5;
            font-family: Arial, sans-serif;
            color: #38251c;
        }

        .invoice {
            max-width: 750px;
            margin: 20px auto;
            padding: 40px;
            background: white;
            border: 2px solid #c49a45;
            border-radius: 12px;
            box-shadow: 0 5px 20px #00000012;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #c49a45;
            padding-bottom: 20px;
        }

            .header h1 {
                color: #70452f;
                margin-bottom: 8px;
            }

            .header h2 {
                color: #9b7028;
                letter-spacing: 2px;
            }

        .details {
            margin-top: 25px;
            line-height: 2;
        }

            .details p {
                margin: 5px 0;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
        }

        th, td {
            padding: 14px;
            border: 1px solid #dfd2bd;
            text-align: left;
        }

        th {
            background: #70452f;
            color: white;
        }

        .total {
            margin-top: 25px;
            text-align: right;
            font-size: 22px;
            font-weight: bold;
            color: #9b7028;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            color: #806d5d;
        }

        .buttons {
            text-align: center;
            margin-top: 25px;
        }

        button, .back {
            display: inline-block;
            padding: 12px 22px;
            background: #70452f;
            color: white;
            border: none;
            border-radius: 6px;
            text-decoration: none;
            cursor: pointer;
            margin: 5px;
        }

        .back {
            background: #777;
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .invoice {
                border: none;
                box-shadow: none;
                margin: 0 auto;
            }

            .buttons {
                display: none;
            }
        }

        @@media (max-width: 600px) {
            body {
                padding: 10px;
            }

            .invoice {
                padding: 18px;
            }

            th, td {
                padding: 8px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <div class="invoice">

        <div class="header">
            <h1>@shopName</h1>
            <h2>SALES INVOICE</h2>
            <p>Invoice Number: INV-@Model.Id</p>
        </div>

        <div class="details">
            <p>
                <strong>Customer Name:</strong>
                @customerName
            </p>

            <p>
                <strong>Customer Phone:</strong>
                @customerPhone
            </p>

            <p>
                <strong>Invoice Date:</strong>
                @Model.SaleDate.ToString("dd-MM-yyyy hh:mm tt")
            </p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>@(Model.Product?.Name ?? "Product unavailable")</td>
                    <td>@Model.Quantity</td>
                    <td>₹@Model.UnitPrice.ToString("N2")</td>
                    <td>₹@Model.TotalAmount.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <div class="total">
            Total Amount: ₹@Model.TotalAmount.ToString("N2")
        </div>

        <div class="footer">
            <h3>Thank You for Shopping!</h3>
            <p>Visit Again</p>
        </div>

        <div class="buttons">
            <button type="button" onclick="window.print()">
                Print / Save as PDF
            </button>

            <a href="@Url.Action("Index", "Sales")" class="back">
                Back to Sales
            </a>
        </div>

    </div>

</body>
</html>