@model SmartInventory.Models.Sale

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>New Sale - SmartInventory</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            background: #f5f1eb;
            font-family: Arial, sans-serif;
            color: #3d2b1f;
        }

        .container {
            max-width: 650px;
            margin: 30px auto;
            background: white;
            padding: 30px;
            border: 1px solid #c49a45;
            border-radius: 14px;
            box-shadow: 0 4px 15px #00000015;
        }

        h1 {
            color: #6b472e;
        }

        label {
            display: block;
            margin-top: 18px;
            margin-bottom: 7px;
            font-weight: bold;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border: 1px solid #d6c8b8;
            border-radius: 7px;
            font-size: 15px;
        }

            input:focus, select:focus {
                outline: none;
                border-color: #c49a45;
            }

        .btn {
            display: inline-block;
            margin-top: 22px;
            padding: 12px 20px;
            background: #80552f;
            color: white;
            border: none;
            border-radius: 7px;
            text-decoration: none;
            cursor: pointer;
        }

        .back {
            background: #777;
            margin-left: 8px;
        }

        .error {
            color: #b42318;
            margin-top: 12px;
        }

        @@media (max-width: 600px) {
            body {
                padding: 10px;
            }

            .container {
                margin: 10px auto;
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="container">

        <h1>Record New Sale</h1>
        <p>Product select karo aur sold quantity enter karo.</p>

        <form asp-controller="Sales" asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="error"></div>

            <label for="ProductId">Select Product</label>

            @Html.DropDownListFor(
            m => m.ProductId,
                        (IEnumerable<SelectListItem>)ViewBag.Products,
                        "-- Select Product --"
                        )

            <label for="Quantity">Quantity Sold</label>
            <input type="number"
                   id="Quantity"
                   name="Quantity"
                   value="@(Model?.Quantity ?? 1)"
                   min="1"
                   required />

            <span asp-validation-for="Quantity" class="error"></span>

            <label for="CustomerName">Customer Name (Optional)</label>
            <input type="text"
                   id="CustomerName"
                   name="CustomerName"
                   value="@(Model?.CustomerName ?? "")"
                   placeholder="Enter customer name" />

            <label for="CustomerPhone">Customer Phone Number (Optional)</label>
            <input type="tel"
                   id="CustomerPhone"
                   name="CustomerPhone"
                   value="@(Model?.CustomerPhone ?? "")"
                   maxlength="15"
                   placeholder="Enter customer phone number" />

            <button type="submit" class="btn">Save Sale</button>

            <a href="@Url.Action("Index", "Sales")" class="btn back">
                Back
            </a>

        </form>

    </div>
</body>
</html>